generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  normalizedEmail String        @unique @map("normalized_email")
  passwordHash    String?       @map("password_hash")
  image           String?
  status          UserStatus    @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  accounts        Account[]
  sessions        Session[]
  emailVerificationTokens EmailVerificationToken[]
  roles           UserRole[]
  enrollments     Enrollment[]
  booksCreated    Book[]        @relation("BookCreatedBy")
  notesCreated    Note[]        @relation("NoteCreatedBy")
  videosCreated   Video[]       @relation("VideoCreatedBy")
  linksCreated    ImportantLink[] @relation("LinkCreatedBy")
  examsCreated    Exam[]        @relation("ExamCreatedBy")
  questionsCreated Question[]   @relation("QuestionCreatedBy")
  filesUploaded   FileAsset[]   @relation("FileUploadedBy")
  attempts        ExamAttempt[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Grade {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  sortOrder    Int            @map("sort_order")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  enrollments  Enrollment[]
  gradeSubjects GradeSubject[]
  links        ImportantLink[]

  @@index([isActive, sortOrder])
  @@map("grades")
}

model Track {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  enrollments   Enrollment[]
  gradeSubjects GradeSubject[]

  @@map("tracks")
}

model Subject {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  gradeSubjects GradeSubject[]
  links         ImportantLink[]

  @@map("subjects")
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  gradeId   String    @map("grade_id")
  trackId   String    @map("track_id")
  isCurrent Boolean   @default(true) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  changedAt DateTime? @map("changed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade Grade @relation(fields: [gradeId], references: [id])
  track Track @relation(fields: [trackId], references: [id])

  @@index([userId, isCurrent])
  @@index([gradeId, trackId, isCurrent])
  @@map("enrollments")
}

model GradeSubject {
  id        String   @id @default(cuid())
  gradeId   String   @map("grade_id")
  subjectId String   @map("subject_id")
  trackId   String?  @map("track_id")
  isActive  Boolean  @default(true) @map("is_active")

  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  track   Track?  @relation(fields: [trackId], references: [id])
  books   Book[]
  notes   Note[]
  videos  Video[]
  exams   Exam[]
  questions Question[]

  @@unique([gradeId, subjectId, trackId])
  @@index([gradeId, trackId, isActive])
  @@map("grade_subjects")
}

model FileAsset {
  id           String      @id @default(cuid())
  provider     StorageProvider
  bucket       String
  objectKey    String      @unique @map("object_key")
  originalName String      @map("original_name")
  safeName     String      @map("safe_name")
  mimeType     String      @map("mime_type")
  sizeBytes    BigInt      @map("size_bytes")
  sha256       String?
  status       FileStatus  @default(PENDING)
  uploadedById String      @map("uploaded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  deletedAt    DateTime?   @map("deleted_at")

  uploadedBy   User        @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  books        Book[]
  notes        Note[]
  coverBooks   Book[]      @relation("BookCover")
  coverNotes   Note[]      @relation("NoteCover")
  thumbnails   Video[]     @relation("VideoThumbnail")

  @@index([status])
  @@index([uploadedById])
  @@map("file_assets")
}

model Book {
  id             String       @id @default(cuid())
  gradeSubjectId String       @map("grade_subject_id")
  title          String
  description    String?      @db.Text
  fileAssetId    String       @map("file_asset_id")
  coverAssetId   String?      @map("cover_asset_id")
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?    @map("published_at")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  gradeSubject GradeSubject @relation(fields: [gradeSubjectId], references: [id])
  fileAsset    FileAsset    @relation(fields: [fileAssetId], references: [id])
  coverAsset   FileAsset?   @relation("BookCover", fields: [coverAssetId], references: [id])
  createdBy    User         @relation("BookCreatedBy", fields: [createdById], references: [id])

  @@index([gradeSubjectId, status, publishedAt])
  @@index([createdById])
  @@map("books")
}

model Note {
  id             String       @id @default(cuid())
  gradeSubjectId String       @map("grade_subject_id")
  title          String
  description    String?      @db.Text
  fileAssetId    String       @map("file_asset_id")
  coverAssetId   String?      @map("cover_asset_id")
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?    @map("published_at")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  gradeSubject GradeSubject @relation(fields: [gradeSubjectId], references: [id])
  fileAsset    FileAsset    @relation(fields: [fileAssetId], references: [id])
  coverAsset   FileAsset?   @relation("NoteCover", fields: [coverAssetId], references: [id])
  createdBy    User         @relation("NoteCreatedBy", fields: [createdById], references: [id])

  @@index([gradeSubjectId, status, publishedAt])
  @@map("notes")
}

model Video {
  id              String       @id @default(cuid())
  gradeSubjectId  String       @map("grade_subject_id")
  title           String
  description     String?      @db.Text
  provider        VideoProvider
  providerVideoId String       @map("provider_video_id")
  thumbnailAssetId String?     @map("thumbnail_asset_id")
  durationSeconds Int?         @map("duration_seconds")
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?    @map("published_at")
  createdById     String       @map("created_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  gradeSubject GradeSubject @relation(fields: [gradeSubjectId], references: [id])
  thumbnail   FileAsset?   @relation("VideoThumbnail", fields: [thumbnailAssetId], references: [id])
  createdBy   User         @relation("VideoCreatedBy", fields: [createdById], references: [id])

  @@index([gradeSubjectId, status, publishedAt])
  @@index([provider, providerVideoId])
  @@map("videos")
}

model ImportantLink {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  url         String       @db.Text
  gradeId     String?      @map("grade_id")
  subjectId   String?      @map("subject_id")
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  grade     Grade?   @relation(fields: [gradeId], references: [id])
  subject   Subject? @relation(fields: [subjectId], references: [id])
  createdBy User     @relation("LinkCreatedBy", fields: [createdById], references: [id])

  @@index([gradeId, subjectId, isActive, sortOrder])
  @@map("important_links")
}

model Exam {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  gradeSubjectId String       @map("grade_subject_id")
  status         ExamStatus   @default(DRAFT)
  durationSeconds Int?        @map("duration_seconds")
  questionCount  Int
  selectionMode  SelectionMode @default(FIXED) @map("selection_mode")
  maxAttempts    Int          @default(1) @map("max_attempts")
  startsAt       DateTime?    @map("starts_at")
  endsAt         DateTime?    @map("ends_at")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  gradeSubject GradeSubject @relation(fields: [gradeSubjectId], references: [id])
  createdBy    User         @relation("ExamCreatedBy", fields: [createdById], references: [id])
  questions    ExamQuestion[]
  attempts     ExamAttempt[]

  @@index([gradeSubjectId, status, startsAt])
  @@map("exams")
}

model Question {
  id             String       @id @default(cuid())
  gradeSubjectId String       @map("grade_subject_id")
  body           String       @db.Text
  explanation    String?      @db.Text
  difficulty     Difficulty   @default(MEDIUM)
  status         ContentStatus @default(DRAFT)
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  gradeSubject GradeSubject  @relation(fields: [gradeSubjectId], references: [id])
  choices      Choice[]
  correctAnswer CorrectAnswer?
  exams        ExamQuestion[]
  createdBy    User          @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  answers      StudentAnswer[]

  @@index([gradeSubjectId, status])
  @@map("questions")
}

model Choice {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  label      String
  text       String   @db.Text
  sortOrder  Int      @map("sort_order")

  question      Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctFor    CorrectAnswer?
  studentAnswers StudentAnswer[]

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("choices")
}

model CorrectAnswer {
  questionId String @id @map("question_id")
  choiceId   String @unique @map("choice_id")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice   Choice   @relation(fields: [choiceId], references: [id])

  @@map("correct_answers")
}

model ExamQuestion {
  examId     String @map("exam_id")
  questionId String @map("question_id")
  sortOrder  Int    @map("sort_order")
  points     Int    @default(1)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([examId, questionId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id              String        @id @default(cuid())
  examId          String        @map("exam_id")
  userId          String        @map("user_id")
  status          AttemptStatus @default(IN_PROGRESS)
  attemptNumber   Int           @map("attempt_number")
  startedAt       DateTime      @default(now()) @map("started_at")
  expiresAt       DateTime?     @map("expires_at")
  submittedAt     DateTime?     @map("submitted_at")
  correctCount    Int           @default(0) @map("correct_count")
  wrongCount      Int           @default(0) @map("wrong_count")
  unansweredCount Int           @default(0) @map("unanswered_count")
  totalScore      Int           @default(0) @map("total_score")
  percentage      Decimal?      @db.Decimal(5, 2)
  submissionKey   String?       @unique @map("submission_key")
  createdAt       DateTime      @default(now()) @map("created_at")

  exam    Exam            @relation(fields: [examId], references: [id])
  user    User            @relation(fields: [userId], references: [id])
  answers StudentAnswer[]

  @@unique([examId, userId, attemptNumber])
  @@index([userId, status])
  @@index([examId, status])
  @@map("exam_attempts")
}

model StudentAnswer {
  id               String   @id @default(cuid())
  attemptId        String   @map("attempt_id")
  questionId       String   @map("question_id")
  selectedChoiceId String?  @map("selected_choice_id")
  isCorrect        Boolean?
  answeredAt       DateTime @default(now()) @map("answered_at")

  attempt        ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id])
  selectedChoice Choice?     @relation(fields: [selectedChoiceId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("student_answers")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipHash      String?  @map("ip_hash")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum StorageProvider {
  R2
  S3
  LOCAL
}

enum FileStatus {
  PENDING
  UPLOADED
  SCANNING
  READY
  QUARANTINED
  DELETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VideoProvider {
  CLOUDFLARE_STREAM
  R2_HLS
  YOUTUBE
  EXTERNAL
}

enum ExamStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SelectionMode {
  FIXED
  RANDOM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  CANCELLED
}
