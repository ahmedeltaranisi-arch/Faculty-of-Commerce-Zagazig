# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/commerce_zagazig?sslmode=require

# App / Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
AUTH_SECRET=replace-with-a-long-random-secret
# Auth.js trusts localhost in development. Set this to true on a trusted production proxy if needed.
AUTH_TRUST_HOST=true

# Keep this false until an email provider is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Optional OAuth providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Optional email provider
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_PROVIDER_URL=https://api.resend.com/emails
